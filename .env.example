# Copy to .env (never commit .env). Names only here - real values go in Fly secrets / Vercel env.

# ---- API + simulator (Fly.io: `fly secrets set NAME=value`) ----
# Leave SUPABASE_URL empty to run the API in stub mode (returns fixtures/sample_responses.json).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # secret: never in the browser, never in git
CORS_ORIGINS=*
SIM_TICK_SECONDS=60

# ---- Web (Vercel env vars; also web/.env.local for local dev) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=    # safe for the browser (RLS is read-only)
NEXT_PUBLIC_API_URL=              # e.g. https://lehigh-parking-api.fly.dev
