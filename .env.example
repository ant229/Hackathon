# SpotStack environment variables. Names only; every variable has a default,
# so nothing needs to be set for a local run. Copy to .env if you want to override.

# --- API (api/app/main.py) ---
# Path to the seed fixture. Default: fixtures/seed.json.
SEED_PATH=
# Days of synthetic session history generated at startup. Default: 28.
HISTORY_DAYS=
# Random seed for the simulator (same seed gives the same history). Default: 7.
SIM_RNG_SEED=
# Comma-separated browser origins allowed by CORS. Default: http://localhost:3000.
CORS_ORIGINS=

# --- Web (web/lib/api.ts) ---
# Base URL of the SpotStack API. Default: http://localhost:8000.
NEXT_PUBLIC_API_URL=
